# SQLite database location (Prisma)
DATABASE_URL=file:./db/custom.db

# Optional — fixed application secret used for:
#   1) signing session JWTs (HS256)
#   2) deriving the AES-256-GCM key that encrypts AI provider API keys at rest
# If left unset, the app generates a strong random secret once and persists it
# to db/.app-secret (which is committed in this private repository so that
# encrypted data stays readable after a deployment to another server).
# Only set this if you want to override the file-based secret — note that
# changing it invalidates existing sessions and previously encrypted keys.
# APP_SECRET=

